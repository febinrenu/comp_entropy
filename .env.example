# Backend Configuration
DATABASE_URL=postgresql://user:password@host:5432/database
SECRET_KEY=your-production-secret-key-min-32-chars
DEBUG=false
PORT=8000

# Frontend URL for CORS
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app

# LLM Settings
# Local dev default is "ollama" (requires a running Ollama server); use
# "simulation" here for a hosted deployment with no reachable Ollama
# instance and no OpenAI/Anthropic key configured.
LLM_PROVIDER=simulation
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3.5:3.8b
OPENAI_API_KEY=your-openai-key-if-using-openai
ANTHROPIC_API_KEY=your-anthropic-key-if-using-anthropic

# Energy Monitoring
# Gates whether the backend attempts real NVML GPU power reads at all.
# Real GPU energy also requires an actual NVIDIA GPU + driver to be
# present -- irrelevant on most hosted platforms (e.g. Render's free
# tier), where this should stay false.
ENABLE_GPU_MONITORING=false

# Frontend Configuration (in separate .env)
# REACT_APP_API_URL=https://your-backend-url.onrender.com/api
